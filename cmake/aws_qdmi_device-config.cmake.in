# ============================================================================
# AWS QDMI Device - CMake Package Configuration File
# ============================================================================
# This file allows other CMake projects to find and use aws-qdmi-device
# via find_package(aws_qdmi_device).
#
# Usage in another project's CMakeLists.txt:
#   find_package(aws_qdmi_device REQUIRED)
#   target_link_libraries(my_app PRIVATE aws_qdmi_device::aws_qdmi_device)
# ============================================================================

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/aws_qdmi_deviceTargets.cmake")

check_required_components(aws_qdmi_device)
